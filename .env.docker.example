# Copy to .env before running docker compose.

# Base image used to build the Yamibo app. If Docker Hub is blocked or slow,
# override this with an accessible mirror, for example:
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PYTHON_IMAGE=python:3.12-slim

# PostgreSQL. Change the password before exposing this outside localhost.
POSTGRES_DB=yamibo
POSTGRES_USER=yamibo
POSTGRES_PASSWORD=yamibo
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

# Use the named volume by default. To bind-mount PostgreSQL data instead, set:
# YAMIBO_POSTGRES_DATA=./postgres-data
YAMIBO_POSTGRES_DATA=yamibo_postgres_data

# Yamibo bind mounts. The app stores archives, exports, backups, staging files,
# title hints, and account-pool cookies under /app/data. Cookie files should live
# in ./data/cookies and are seen by the container as /app/data/cookies.
YAMIBO_DATA_BIND=./data
YAMIBO_CONFIG_BIND=./data/yamibo.local.json
YAMIBO_WEB_BIND_HOST=127.0.0.1
YAMIBO_WEB_PORT=8765
YAMIBO_MCP_BIND_HOST=127.0.0.1
YAMIBO_MCP_PORT=8000
YAMIBO_WORKER_ID=docker-daemon
YAMIBO_WORKER_PARALLELISM=2
YAMIBO_DB_POOL_MIN=1
YAMIBO_DB_POOL_MAX=5

# Chat model for the embedded Pydantic AI Web Chat and title parsing.
# Supply the real external OpenAI-compatible endpoint, model, and key in the deployment environment.
YAMIBO_CHAT_BACKEND=embedded
YAMIBO_LLM_BASE_URL=https://api.openai.com/v1
YAMIBO_LLM_API_KEY=
YAMIBO_LLM_MODEL=gpt-4.1-mini

# RAG embeddings. Keep false until an embedding-capable external API is configured.
# For production RAG, point these to an embedding-capable OpenAI-compatible service.
YAMIBO_RAG_ENABLED=false
YAMIBO_RAG_BASE_URL=https://api.openai.com/v1
YAMIBO_RAG_API_KEY=
YAMIBO_RAG_EMBEDDING_MODEL=text-embedding-3-small
YAMIBO_RAG_EMBEDDING_DIMENSIONS=512
